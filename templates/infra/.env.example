# Optional docker compose port. Runtime configuration can also be exported.
APP_PORT=8000
# Developer API index, Swagger/ReDoc and OpenAPI. Set false to disable together.
ENABLE_API_DOCS=true
# For direct uvicorn execution:
# DATA_DIR=.local/app
# STATIC_DIR=frontend/dist
# 외부 미리보기 URL의 신뢰할 수 있는 호스트만 지정합니다. make ui에 환경 변수로 전달하거나 frontend/.env.local에 둡니다.
# KIT_PREVIEW_HOSTS=preview.example.test
